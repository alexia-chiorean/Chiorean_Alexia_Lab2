@page "{id:int?}"
@model Chiorean_Alexia_Lab2.Pages_Publishers.IndexModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Publishers</title>
</head>
<body>
    <p>
        <a asp-page="Create">Create New</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Publisher Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PublisherData.Publishers)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.PublisherName)
                    </td>
                    <td>
                        <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                        <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.PublisherData.Books != null)
    {
        <h3>Books by selected publisher</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PublisherData.Books)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Author?.FullName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</body>
</html>
